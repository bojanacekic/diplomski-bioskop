ConnectionStrings__AuthDatabase=Server=localhost\SQLEXPRESS;Database=DiplomskiAuthDb;Trusted_Connection=True;TrustServerCertificate=True;
Jwt__Issuer=SmartCinema.Auth
Jwt__Audience=SmartCinema.Client
Jwt__SecretKey=replace-with-the-same-secret-at-least-32-characters-long
Jwt__ExpirationMinutes=60
